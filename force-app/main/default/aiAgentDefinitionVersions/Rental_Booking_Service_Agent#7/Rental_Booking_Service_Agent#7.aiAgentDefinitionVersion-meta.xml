            <localActions>
                <description>Updates the existing Booking record in Salesforce for changed fields only.</description>
                <invocationTarget>AmendBookingAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Amend_Booking</localDeveloperName>
                <masterLabel>Amend Booking</masterLabel>
            </localActions>
            <localActions>
                <description>Sets the Booking record Status to Cancelled in Salesforce.</description>
                <invocationTarget>CancelBookingAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Cancel_Booking</localDeveloperName>
                <masterLabel>Cancel Booking</masterLabel>
            </localActions>
            <localActions>
                <description>Returns amendment and rebooking options for a verified booking. Always call this when the customer asks to cancel, before Cancel Booking, and present options in plain language: (1) amend dates, locations, email, or flight, (2) rebook a different vehicle or time, (3) cancel only if they still want to cancel. Requires Verified Contact Id and Booking Number. Use also when the customer is unsure whether to change or cancel. Do not use this action to verify identity, save an amendment, create a new booking, or cancel. Never treat this action as a completed cancellation.</description>
                <invocationTarget>GetBookingAlternativesAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Get_Booking_Alternatives</localDeveloperName>
                <masterLabel>Get Booking Alternatives</masterLabel>
            </localActions>
            <localActions>
                <description>Loads one verified customer&apos;s rental booking from Salesforce, including pickup, drop-off, vehicle, email, flight, status, and cancellation fee.</description>
                <invocationTarget>GetBookingDetailsAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Get_Booking_Details</localDeveloperName>
                <masterLabel>Get Booking Details</masterLabel>
            </localActions>
            <localActions>
                <description>Creates a new Booking record in Salesforce and sets the original booking Status to Rebooked.</description>
                <invocationTarget>RebookVehicleAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Rebook_Vehicle</localDeveloperName>
                <masterLabel>Rebook Vehicle</masterLabel>
            </localActions>
            <localActions>
                <description>Verifies the customer before any private booking action by matching booking number and the email on the reservation. Use this as the first action in a Booking Changes conversation, or whenever Verified Contact Id is missing. On success, store Verified Contact Id and Booking Number in agent variables and confirm the trip in plain language. Do not use this action to look up full booking details, offer alternatives, amend, rebook, or cancel. Do not invent a booking number or email. If verification fails, ask the customer to recheck booking number and email. Do not expose Salesforce IDs to the customer.</description>
                <invocationTarget>VerifyCustomerIdentityAction</invocationTarget>
                <invocationTargetType>apex</invocationTargetType>
                <isConfirmationRequired>false</isConfirmationRequired>
                <isIncludeInProgressIndicator>false</isIncludeInProgressIndicator>
                <localDeveloperName>Verify_Customer_Identity</localDeveloperName>
                <masterLabel>Verify Customer Identity</masterLabel>
